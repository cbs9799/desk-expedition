          }
        }
      }
    },
    "도감 %lld/%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dex %lld/%lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "도감 %1$lld/%2$lld"
          }
        }
      }
    },
    "띠 오른쪽에 마우스를 올리면 바로 조작할 수 있어요: 지역 이름 ▾로 지역 이동, 웨이브 보석으로 웨이브 선택, 영웅 칩으로 레벨업, ⚖️로 전술. ★가 뜨면 특성을 고를 차례예요. 장비는 자동 정리가 알아서 해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover the right side of the band to play: region name ▾ to travel, wave gems to pick a wave, hero chips to level up, ⚖️ for tactics. A ★ means a trait is ready. Auto-tidy handles gear."
          }
        }
      }
    },
    "띠를 두 번 클릭해도 본부가 열려요 (클릭 통과를 끈 경우)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click the band to open HQ (when click-through is off)"
          }
        }
      }
    },
    "레벨·장비·골드·지역이 처음으로 돌아가는 대신 추억 조각을 얻어요. 조각 하나당 공격력과 골드가 영구히 +5%. 도감·일지·트로피·이름·꾸미기는 그대로 가져가요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels, gear, gold and regions reset, and you earn Memory shards instead. Each shard is a permanent +5% attack and gold. Dex, journal, trophies, names and styles come with you."
          }
        }
      }
    },
    "레벨·장비·골드·지역이 초기화되고 추억 조각 %lld개를 얻어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Levels, gear, gold and regions reset and you get %lld Memory shards."
          }
        }
      }
    },
    "레벨업  🪙 %@": {
      "localizations": {
